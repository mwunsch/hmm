#!/bin/sh

set -u

HMM_VERSION=0.1.0

die() {
  printf 'hmm: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
usage: hmm [options] [prompt]

Options:
  --new, --reset          Start a fresh terminal session
  --show                  Show the current terminal session id
  --model, -m <model>     Use a Codex model for this turn
  --profile, -p <name>    Use a Codex config profile
  --config, -c <k=v>      Pass a Codex config override
  --file, -f <file>       Read the prompt from a file (- for stdin)
  --host, --ssh <host>    Inspect a remote host over local ssh
  --write                 Allow workspace writes for this turn
  --danger                Bypass Codex approvals and sandboxing
  --quiet                 Print only assistant messages
  --verbose               Show extra event details
  --json                  Print raw Codex JSONL events
  --color <mode>          auto, always, or never
  --no-color              Disable color
  --no-spinner            Disable the thinking indicator
  --instructions <text>   Override the default hmm instruction prefix
  --no-instructions       Send the prompt without hmm's instruction prefix
  --version               Show hmm version
  --help, -h              Show this help
EOF
}

version() {
  printf 'hmm %s\n' "$HMM_VERSION"
}

need() {
  command -v "$1" >/dev/null 2>&1 || die "missing required dependency: $1"
}

read_all() {
  while IFS= read -r line || [ -n "$line" ]; do
    printf '%s\n' "$line"
  done
}

host_name_part() {
  case $1 in
    *@*) printf '%s' "${1##*@}" ;;
    *) printf '%s' "$1" ;;
  esac
}

resolve_host_ip() {
  host=$1
  ip=

  if command -v dscacheutil >/dev/null 2>&1; then
    ip=$(dscacheutil -q host -a name "$host" 2>/dev/null | awk '/^ip_address:/ { print $2; exit }')
    if [ -n "$ip" ]; then
      printf '%s\n' "$ip"
      return
    fi
  fi

  if command -v getent >/dev/null 2>&1; then
    ip=$(getent hosts "$host" 2>/dev/null | awk '{ print $1; exit }')
    if [ -n "$ip" ]; then
      printf '%s\n' "$ip"
      return
    fi
  fi

  if command -v tailscale >/dev/null 2>&1; then
    tailscale ip -4 "$host" 2>/dev/null | sed -n '1p'
  fi
}

compose_prompt() {
  [ -r /dev/tty ] || return 1

  use_style=0
  if { [ -t 0 ] || [ -t 2 ]; } && command -v tput >/dev/null 2>&1; then
    use_style=1
  fi

  if [ "$use_style" -eq 1 ]; then
    bold=$(tput bold 2>/dev/null || printf '')
    dim=$(tput dim 2>/dev/null || printf '')
    cyan=$(tput setaf 6 2>/dev/null || printf '')
    green=$(tput setaf 2 2>/dev/null || printf '')
    yellow=$(tput setaf 3 2>/dev/null || printf '')
    reset=$(tput sgr0 2>/dev/null || printf '')
  else
    bold= dim= cyan= green= yellow= reset=
  fi

  printf '%s╭─%s %s%shmm%s %scompose%s\n' "$cyan" "$reset" "$yellow" "$bold" "$reset" "$dim" "$reset" >/dev/tty
  printf '%s│%s  Type or paste your prompt. %sEnter%s adds a line. %sCtrl-D%s sends. %sCtrl-C%s cancels.\n' "$cyan" "$reset" "$yellow" "$reset" "$green" "$reset" "$dim" "$reset" >/dev/tty
  printf '%s│%s\n' "$cyan" "$reset" >/dev/tty

  prompt=
  have_input=0
  while :; do
    printf '%s│%s ' "$cyan" "$reset" >/dev/tty
    if IFS= read -r line </dev/tty; then
      if [ "$have_input" -eq 0 ]; then
        prompt=$line
      else
        prompt=$(printf '%s\n%s' "$prompt" "$line")
      fi
      have_input=1
    else
      printf '\n%s╰─%s %ssend%s\n' "$cyan" "$reset" "$green" "$reset" >/dev/tty
      break
    fi
  done

  [ "$have_input" -eq 1 ] || return 130
  printf '%s' "$prompt"
}

script=$0
case $script in
  */*) ;;
  *) script=$(command -v -- "$script" 2>/dev/null || printf '%s' "$script") ;;
esac

script_dir=$(CDPATH= cd -- "$(dirname -- "$script")" 2>/dev/null && pwd -P) || die "cannot resolve script directory"
root_dir=$(CDPATH= cd -- "$script_dir/.." 2>/dev/null && pwd -P) || die "cannot resolve install root"
libexec_dir=${HMM_LIBEXEC:-"$root_dir/libexec"}

session_tool=$libexec_dir/hmm-session
codex_tool=$libexec_dir/hmm-codex
render_tool=$libexec_dir/hmm-render

[ -x "$session_tool" ] || die "missing libexec helper: $session_tool"
[ -x "$codex_tool" ] || die "missing libexec helper: $codex_tool"
[ -x "$render_tool" ] || die "missing libexec helper: $render_tool"

if [ -z "${HMM_SHELL_PID:-}" ]; then
  HMM_SHELL_PID=${PPID:-unknown}
fi

if [ -z "${HMM_TTY:-}" ]; then
  HMM_TTY=$(tty 2>/dev/null || printf 'notty')
fi

export HMM_SHELL_PID HMM_TTY

codex_args=

add_codex_arg() {
  codex_args=$codex_args$1'
'
}

reset=0
show=0
safety=read-only
quiet=0
verbose=0
raw_json=0
color=auto
spinner=auto
model_for_usage=
prompt_file=
remote_host=
instructions=${HMM_INSTRUCTIONS:-You are hmm, a terse terminal assistant. Answer briefly and directly. Prefer the smallest useful answer. Do not inspect files or run tools unless needed to answer or act. When tools are needed, keep progress updates short.}
use_instructions=1

while [ "$#" -gt 0 ]; do
  case $1 in
    --)
      shift
      break
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    --version)
      version
      exit 0
      ;;
    --new|--reset)
      reset=1
      shift
      ;;
    --show)
      show=1
      shift
      ;;
    --model|-m)
      [ "$#" -ge 2 ] || die "$1 requires a value"
      add_codex_arg "--model"
      add_codex_arg "$2"
      model_for_usage=$2
      shift 2
      ;;
    --model=*)
      value=${1#--model=}
      add_codex_arg "--model"
      add_codex_arg "$value"
      model_for_usage=$value
      shift
      ;;
    --profile|-p)
      [ "$#" -ge 2 ] || die "$1 requires a value"
      add_codex_arg "--profile"
      add_codex_arg "$2"
      shift 2
      ;;
    --profile=*)
      add_codex_arg "--profile"
      add_codex_arg "${1#--profile=}"
      shift
      ;;
    --config|-c)
      [ "$#" -ge 2 ] || die "$1 requires a value"
      add_codex_arg "--config"
      add_codex_arg "$2"
      shift 2
      ;;
    --config=*)
      add_codex_arg "--config"
      add_codex_arg "${1#--config=}"
      shift
      ;;
    --file|-f)
      [ "$#" -ge 2 ] || die "$1 requires a value"
      prompt_file=$2
      shift 2
      ;;
    --file=*)
      prompt_file=${1#--file=}
      shift
      ;;
    --host|--ssh)
      [ "$#" -ge 2 ] || die "$1 requires a value"
      [ -n "$2" ] || die "$1 requires a non-empty host"
      remote_host=$2
      shift 2
      ;;
    --host=*|--ssh=*)
      remote_host=${1#*=}
      [ -n "$remote_host" ] || die "${1%%=*} requires a non-empty host"
      shift
      ;;
    --enable|--disable|--image|-i|--cd|-C|--add-dir|--local-provider|--output-schema)
      [ "$#" -ge 2 ] || die "$1 requires a value"
      add_codex_arg "$1"
      add_codex_arg "$2"
      shift 2
      ;;
    --enable=*|--disable=*|--image=*|--cd=*|--add-dir=*|--local-provider=*|--output-schema=*)
      name=${1%%=*}
      value=${1#*=}
      add_codex_arg "$name"
      add_codex_arg "$value"
      shift
      ;;
    --strict-config|--oss|--ignore-user-config|--ignore-rules|--dangerously-bypass-hook-trust)
      add_codex_arg "$1"
      shift
      ;;
    --write)
      safety=workspace-write
      shift
      ;;
    --danger)
      safety=danger
      shift
      ;;
    --quiet)
      quiet=1
      shift
      ;;
    --verbose)
      verbose=1
      shift
      ;;
    --json)
      raw_json=1
      spinner=never
      color=never
      shift
      ;;
    --color)
      [ "$#" -ge 2 ] || die "$1 requires a value"
      color=$2
      shift 2
      ;;
    --color=*)
      color=${1#--color=}
      shift
      ;;
    --no-color)
      color=never
      shift
      ;;
    --no-spinner)
      spinner=never
      shift
      ;;
    --instructions)
      [ "$#" -ge 2 ] || die "$1 requires a value"
      instructions=$2
      use_instructions=1
      shift 2
      ;;
    --instructions=*)
      instructions=${1#--instructions=}
      use_instructions=1
      shift
      ;;
    --no-instructions)
      use_instructions=0
      shift
      ;;
    --*)
      break
      ;;
    *)
      break
      ;;
  esac
done

case $color in
  auto|always|never) ;;
  *) die "--color must be auto, always, or never" ;;
esac

if [ -n "$remote_host" ]; then
  HMM_SESSION_SCOPE=host:$remote_host
  export HMM_SESSION_SCOPE
fi

if [ "$reset" -eq 1 ]; then
  $session_tool reset || exit 1
fi

if [ "$show" -eq 1 ]; then
  $session_tool show
  exit $?
fi

session_file=$($session_tool path) || exit 1

prompt=$*

if [ -n "$prompt_file" ]; then
  [ -z "$prompt" ] || die "--file cannot be combined with prompt arguments"
  if [ "$prompt_file" = - ]; then
    prompt=$(read_all)
  else
    [ -r "$prompt_file" ] || die "cannot read prompt file: $prompt_file"
    prompt=$(read_all <"$prompt_file")
  fi
elif [ -z "$prompt" ] && [ ! -t 0 ]; then
  prompt=$(read_all)
elif [ -z "$prompt" ] && [ -t 0 ]; then
  prompt=$(compose_prompt)
  compose_status=$?
  [ "$compose_status" -eq 0 ] || exit "$compose_status"
fi

[ -n "$prompt" ] || die "usage: hmm <prompt>"

if [ -n "$remote_host" ]; then
  remote_host_name=$(host_name_part "$remote_host")
  remote_host_ip=$(resolve_host_ip "$remote_host_name")
  remote_dns_fallback=
  if [ -n "$remote_host_ip" ] && [ "$remote_host_ip" != "$remote_host_name" ]; then
    remote_dns_fallback=$(printf '%s' "Local preflight resolved $remote_host_name to $remote_host_ip. If ssh reports that $remote_host_name cannot resolve inside the Codex sandbox, use: ssh -o HostName=$remote_host_ip -- $remote_host '<remote command>'")
  fi

  case $safety in
    read-only)
      remote_safety='Default to read-only inspection commands. Do not modify files, services, packages, processes, or configuration on the remote host unless the user explicitly asks and reruns with --write or --danger.'
      ;;
    workspace-write)
      remote_safety='The user passed --write, so remote changes are allowed when needed. Prefer explaining risky changes before running them.'
      ;;
    danger)
      remote_safety='The user passed --danger, so Codex approvals and sandboxing are disabled. Remote destructive commands are allowed only when clearly requested.'
      ;;
  esac

  if [ -n "$remote_dns_fallback" ]; then
    remote_instructions=$(printf '%s\n%s\n%s\n%s\n%s\n%s' \
      "You are inspecting remote host $remote_host from the local machine." \
      "Use local shell commands of the form: ssh -- $remote_host '<remote command>'" \
      "$remote_dns_fallback" \
      "Assume paths, files, processes, services, logs, disks, users, and packages are on $remote_host unless the user says otherwise." \
      "Do not require hmm, codex, jq, or any other hmm dependency to exist on the remote host." \
      "$remote_safety")
  else
    remote_instructions=$(printf '%s\n%s\n%s\n%s\n%s' \
      "You are inspecting remote host $remote_host from the local machine." \
      "Use local shell commands of the form: ssh -- $remote_host '<remote command>'" \
      "Assume paths, files, processes, services, logs, disks, users, and packages are on $remote_host unless the user says otherwise." \
      "Do not require hmm, codex, jq, or any other hmm dependency to exist on the remote host." \
      "$remote_safety")
  fi
fi

if [ "$use_instructions" -eq 1 ] && [ -n "$instructions" ] && [ -n "$remote_host" ]; then
  prompt=$(printf '%s\n\n%s\n\nUser prompt: %s' "$instructions" "$remote_instructions" "$prompt")
elif [ "$use_instructions" -eq 1 ] && [ -n "$instructions" ]; then
  prompt=$(printf '%s\n\nUser prompt: %s' "$instructions" "$prompt")
elif [ -n "$remote_host" ]; then
  prompt=$(printf '%s\n\nUser prompt: %s' "$remote_instructions" "$prompt")
fi

need codex
need jq

run_dir=$(mktemp -d "${TMPDIR:-/tmp}/hmm.XXXXXX") || die "cannot create temp directory"
cleanup() {
  rm -rf "$run_dir"
}
trap cleanup EXIT HUP INT TERM

codex_args_file=$run_dir/codex-args
printf '%s' "$codex_args" >"$codex_args_file" || die "cannot create temp args file"

mode=start
session_id=
if [ -s "$session_file" ]; then
  session_id=$(sed -n '1p' "$session_file")
  if [ -n "$session_id" ]; then
    mode=resume
  fi
fi

if [ "$safety" = danger ] && [ "$raw_json" -eq 0 ]; then
  printf 'hmm: danger mode enabled: Codex approvals and sandboxing are disabled\n' >&2
fi

status_file=$run_dir/codex-status
meta_dir=$run_dir/meta
mkdir -p "$meta_dir" || die "cannot create temp metadata directory"
printf '125\n' >"$status_file" || die "cannot create temp status file"

HMM_CODEX_STATUS_FILE=$status_file \
  "$codex_tool" \
    --mode "$mode" \
    --session-id "$session_id" \
    --args-file "$codex_args_file" \
    --safety "$safety" \
    -- "$prompt" |
  "$render_tool" \
    --meta-dir "$meta_dir" \
    --color "$color" \
    --spinner "$spinner" \
    --model "$model_for_usage" \
    $( [ "$quiet" -eq 1 ] && printf '%s' '--quiet' ) \
    $( [ "$verbose" -eq 1 ] && printf '%s' '--verbose' ) \
    $( [ "$raw_json" -eq 1 ] && printf '%s' '--json' )

render_status=$?
codex_status=125
if [ -s "$status_file" ]; then
  codex_status=$(sed -n '1p' "$status_file")
fi

if [ -s "$meta_dir/thread_id" ]; then
  new_session_id=$(sed -n '1p' "$meta_dir/thread_id")
  if [ -n "$new_session_id" ]; then
    $session_tool save "$new_session_id" >/dev/null || exit 1
  fi
fi

if [ "$codex_status" -ne 0 ]; then
  exit "$codex_status"
fi

exit "$render_status"
